// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
// ------------------------------------
// ⚡️ App Tables
// ------------------------------------

/// The @map("users") attribute is optional, but helps keep the model name
/// singular while mapping to the plural table name.
model User {
  id                    Int      @id @default(autoincrement())
  name                  String?   @db.VarChar(255) // Using a standard length for varchar
  email                 String?   @unique
  password              String?   @db.VarChar(255)
  age                   Int?     // Made nullable in case age is optional
  gender                Gender   
  budgetPreference      String   @map("budget_preference") // e.g. “low”, “medium”, “high”
  dietaryPreferences    Json     @map("dietary_preferences")
  otp                   String   @db.VarChar(6)
  phoneNumber           String   @db.VarChar(20) @unique @map("phone_number")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Relations
  events                Event[]
  reviews               Review[]

  @@map("users")
}

model Restaurant {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(255)
  description    String   @db.Text
  phone          String   @db.VarChar(20) // Assumed max length
  address        String   @db.Text
  latitude       Decimal    @db.Decimal
  longitude      Decimal    @db.Decimal
  avgPrice       Decimal    @db.Decimal @map("avg_price")
  avgPriceLevel  Int      @map("avg_price_level") // (1 = cheap, 2 = mid, 3 = expensive)
  rating         Decimal    @db.Decimal
  openingHours   Json     @map("opening_hours")
  website        String?  @db.VarChar(255) // optional
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  foodItems      FoodItem[]

  @@map("restaurants")
}

model FoodItem {
  id             Int      @id @default(autoincrement())
  restaurantId   Int      @map("restaurant_id")
  name           String   @db.VarChar(255)
  description    String   @db.Text
  category       String   @db.VarChar(100)
  price          Decimal    @db.Decimal
  ingredients    Json
  imageUrl       String?  @map("image_url") // optional
  rating         Decimal    @db.Decimal
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id])
  events         Event[]
  reviews        Review[]

  @@map("food_items")
}

model Event {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  itemId         Int      @map("item_id")
  eventType      EventType @map("event_type")
  value          Float?   // Float can be represented by Float in Prisma
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  user           User     @relation(fields: [userId], references: [id])
  foodItem       FoodItem @relation(fields: [itemId], references: [id])

  @@map("events")
}

model Review {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  itemId         Int      @map("item_id")
  rating         Decimal    @db.Decimal
  comment        String?  @db.Text // Optional textual review
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  user           User     @relation(fields: [userId], references: [id])
  foodItem       FoodItem @relation(fields: [itemId], references: [id])

  @@map("reviews")
}

// ------------------------------------
// 🛡️ Dashboard Tables
// ------------------------------------

model Admin {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(255)
  email          String   @unique
  password       String   @db.VarChar(255)
  roleId         Int      @map("role_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  role           Role     @relation(fields: [roleId], references: [id])
  adminActions   AdminAction[]

  @@map("admins")
}

model Role {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(100) @unique
  description    String   @db.Text
  permissions    Json
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  admins         Admin[]

  @@map("roles")
}

model AdminAction {
  id             Int      @id @default(autoincrement())
  adminId        Int      @map("admin_id")
  action         String   @db.VarChar(100)
  targetTable    String   @map("target_table") @db.VarChar(100)
  targetId       Int      @map("target_id")
  description    String?  @db.Text // Optional details
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  admin          Admin    @relation(fields: [adminId], references: [id])

  @@map("admin_actions")
}

// ------------------------------------
// 📄 Enums
// ------------------------------------

enum Gender {
  male
  female
}

enum EventType {
  view
  click
  like
  order
  rate
}